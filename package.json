{
  "name": "deterministic-motion-documentaries",
  "version": "1.0.0",
  "private": true,
  "description": "Word-synchronized deterministic Remotion motion documentaries",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "typecheck": "tsc --noEmit",
    "verify:sync": "python3 scripts/verify-word-cues.py && node scripts/verify-frame-sync.cjs",
    "render": "remotion render Root out/Bretton-Woods-Global-Dollar.mp4 --props=./props.json --overwrite",
    "render:agent-engine": "remotion render src/index.ts EngineFirstExplainer out/AI-Agent-Engine-First.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=100% --gl=angle --overwrite",
    "render:after-effects": "remotion render src/index.ts TheCodeThatReplacedAfterEffects out/The-Code-That-Replaced-After-Effects.mp4 --codec=h264 --crf=18 --pixel-format=yuv420p --concurrency=100% --gl=angle --overwrite"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@remotion/cli": "4.0.539",
    "@remotion/three": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.180.0",
    "typescript": "5.9.3"
  }
}
