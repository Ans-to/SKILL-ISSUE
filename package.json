{
  "name": "nokia-documentary-remotion",
  "version": "1.0.0",
  "private": true,
  "description": "Cinematic Remotion short documentary: The Empire of Timber & Tech",
  "scripts": {
    "start": "remotion preview src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts NokiaDocumentary out/Nokia-Documentary.mp4 --codec=h264 --crf=18 --concurrency=100% --gl=angle"
  },
  "dependencies": {
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@remotion/cli": "4.0.539",
    "@remotion/three": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.180.0",
    "typescript": "5.9.3"
  }
}
